# Copy this file to .env and replace the placeholder values.
CI_ENV=development
APP_BASE_URL=http://localhost:8080/

# Database connection (use the values from your TablePlus connection).
DB_HOST=127.0.0.1
DB_USERNAME=root
DB_PASSWORD=replace-with-your-mysql-password
DB_DATABASE=mini_erp_smart_life

# Generate a long, unique random value before production deployment.
CI_ENCRYPTION_KEY=replace-with-a-long-random-secret
