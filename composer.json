{
	"description": "SmartLife Mini ERP Stocks & Sales",
	"name": "smartlife/mini-erp",
	"type": "project",
	"homepage": "https://codeigniter.com",
	"license": "MIT",
	"support": {
		"forum": "http://forum.codeigniter.com/",
		"wiki": "https://github.com/bcit-ci/CodeIgniter/wiki",
		"slack": "https://codeigniterchat.slack.com",
		"source": "https://github.com/bcit-ci/CodeIgniter"
	},
	"require": {
		"php": ">=7.4",
		"league/csv": "^9.10"
	},
	"autoload": {
		"psr-4": {
			"App\\Repositories\\": "application/repositories/",
			"App\\Contracts\\": "application/repositories/Contracts/",
			"App\\Services\\": "application/services/",
			"App\\Exceptions\\": "application/exceptions/"
		}
	},
	"autoload-dev": {"psr-4": {"Tests\\": "application/tests/"}},
	"suggest": {
		"paragonie/random_compat": "Provides better randomness in PHP 5.x"
	},
	"scripts": {
		"test": "@php vendor/phpunit/phpunit/phpunit --configuration phpunit.xml",
		"lint": "@php vendor/squizlabs/php_codesniffer/bin/phpcs --standard=.phpcs.xml application/"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.10"
	}
}
